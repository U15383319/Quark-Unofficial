{
	"schemaVersion": 1,
	"id": "zeta",
	"version": "${version}",
	"name": "Zeta Woven",
	"description": "A fully featured Library designed around loading highly configurable, agile developed. modular mods. Zeta Woven is an unofficial Fabric port of Zeta by Vazkii and contributors, made for Quark Woven; it is not affiliated with or endorsed by the Zeta team.",
	"authors": [
		"Gvxwsur",
		"Vazkii",
		"quat",
		"IThundxr",
		"siuol",
		"wiresegal",
		"MehVahdJukaar"
	],
	"contact": {
		"homepage": "https://github.com/U15383319/Quark-Unofficial",
		"sources": "https://github.com/U15383319/Quark-Unofficial",
		"issues": "https://github.com/U15383319/Quark-Unofficial/issues"
	},
	"license": "CC-BY-NC-SA-3.0",
	"icon": "assets/zeta/icon.png",
	"environment": "*",
