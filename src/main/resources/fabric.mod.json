{
	"schemaVersion": 1,
	"id": "quark",
	"version": "${version}",
	"name": "Quark",
	"description": "Small things, improving Minecraft bit by bit. Unofficial Fabric port of the 1.20.1 Forge version.",
	"authors": [
		"Vazkii",
		"WireSegal",
		"MCVinnyq",
		"Sully"
	],
	"contact": {
		"homepage": "https://quarkmod.net",
		"sources": "https://github.com/VazkiiMods/Quark"
	},
	"license": "CC-BY-NC-SA-3.0",
	"icon": "proxypack.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"org.violetmoon.quark.base.QuarkFabric"
		],
		"client": [
			"org.violetmoon.quark.base.QuarkFabricClient"
		],
		"modmenu": [
			"org.violetmoon.quark.base.client.config.QuarkModMenu"
		]
	},
	"mixins": [
		"quark.mixins.json"
	],
	"accessWidener": "quark.accesswidener",
	"depends": {
		"fabricloader": ">=0.15.0",
		"minecraft": "~1.20.1",
		"java": ">=17",
		"fabric-api": "*",
		"zeta": ">=1.0-29"
	},
	"custom": {
		"loom:injected_interfaces": {
			"net/minecraft/class_1297": [
				"org/violetmoon/zetaimplfabric/entity/IZetaEntityExtensions"
			],
			"net/minecraft/class_2586": [
				"org/violetmoon/zetaimplfabric/ext/IZetaBlockEntityExtensions"
			],
			"net/minecraft/class_1799": [
				"org/violetmoon/zetaimplfabric/ext/IZetaItemStackExtensions"
			],
			"net/minecraft/class_4970$class_4971": [
				"org/violetmoon/zetaimplfabric/ext/IZetaBlockStateExtensions"
			],
			"net/minecraft/class_2248": [
				"org/violetmoon/zetaimplfabric/ext/IZetaBlockExtras"
			],
			"net/minecraft/class_1299$class_1300": [
				"org/violetmoon/zetaimplfabric/ext/IZetaEntityTypeBuilderExtensions<TT;>"
			],
			"net/minecraft/class_465": [
				"org/violetmoon/zetaimplfabric/ext/client/IZetaContainerScreenExtensions"
			],
			"net/minecraft/class_437": [
				"org/violetmoon/zetaimplfabric/ext/client/IZetaScreenExtensions"
			],
			"net/minecraft/class_304": [
				"org/violetmoon/zetaimplfabric/ext/client/IZetaKeyMappingExtensions"
			],
			"net/minecraft/class_332": [
				"org/violetmoon/zetaimplfabric/ext/client/IZetaGuiGraphicsExtensions"
			],
			"net/minecraft/class_339": [
				"org/violetmoon/zetaimplfabric/ext/client/IZetaWidgetExtensions"
			],
			"net/minecraft/class_1887": [
				"org/violetmoon/zetaimplfabric/ext/IZetaEnchantmentExtensions"
			],
			"net/minecraft/class_350": [
				"org/violetmoon/zetaimplfabric/ext/client/IZetaSelectionListExtensions"
			],
			"net/minecraft/class_826": [
				"org/violetmoon/zetaimplfabric/ext/client/IZetaChestRendererExtensions<TT;>"
			]
		}
	}
}
